# Required — MySQL stores the chat-to-spreadsheet mapping
MYSQL_DSN=user:password@tcp(127.0.0.1:3306)/keuanganku?parseTime=true

# Google service-account JSON. Required in practice: Google Sheets is where
# wallets and transactions are actually stored.
GOOGLE_CREDENTIALS_FILE=credentials.json

# Optional — natural-language and receipt-photo parsing, via Gemini.
# Get a key at https://aistudio.google.com. Without this the bot runs
# normally but only responds to slash commands.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — override the model. Gemini model IDs retire on a schedule, so
# this is settable without a rebuild.
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional — serve Telegram alongside WhatsApp. Get a token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Optional — set to 1 to skip the whatsmeow QR link. Use this when running
# Telegram-only, or when using the official Cloud API below instead.
DISABLE_WHATSAPP=

# --- Official WhatsApp Business Cloud API (optional) ---
# From developers.facebook.com → your app → WhatsApp. All four are required
# together; the transport stays off unless every one is set.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you invent; paste the same one into the Meta webhook form.
WHATSAPP_VERIFY_TOKEN=
# App Settings → Basic → App Secret. Required: it authenticates Meta's
# webhooks. Without it anyone who finds the URL could post fake transactions.
WHATSAPP_APP_SECRET=

# Optional — Graph API version (defaults to v26.0) and the approved Utility
# template used to prompt users whose 24-hour window has closed.
WHATSAPP_API_VERSION=
WHATSAPP_REENGAGE_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=id

# Where the webhook listens. Put a TLS-terminating proxy or tunnel in front:
# Meta only delivers to public HTTPS.
WEBHOOK_ADDR=:8080
WEBHOOK_PATH=/webhook

# --- Scheduled monthly report (optional, off by default) ---
# Set to 1 to auto-send a PDF recap on the 1st at 07:00. It is the only
# message the bot sends unprompted, which on the WhatsApp Cloud API means a
# billable template conversation outside the free 24-hour service window.
# Leave it off to stay on the free tier — /rekap still works on demand.
ENABLE_MONTHLY_REPORT=
